{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-app-info",
    "allow-ai-http-request",
    "allow-secret-set",
    "allow-secret-get",
    "allow-secret-delete",
    "allow-location-resolve",
    "allow-weather-resolve",
    "allow-project-open-root",
    "allow-project-get-root",
    "allow-project-ensure-layout",
    "allow-project-read-json",
    "allow-project-write-json-atomic",
    "allow-project-delete-file",
    "allow-workspace-open-root",
    "allow-workspace-get-root",
    "allow-workspace-read-json",
    "allow-workspace-write-json-atomic",
    "allow-workspace-ensure-dir",
    "allow-workspace-list-dir",
    "allow-workspace-move-to-trash",
    "allow-workspace-restore-from-trash",
    "allow-ledger-read-head",
    "allow-ledger-read-lines",
    "allow-ledger-append-line",
    "allow-ledger-write-head",
    "allow-ledger-hash-sha256",
    "allow-media-probe",
    "allow-media-import-stereo",
    "allow-media-import-mono-stereo",
    "allow-media-read-file",
    "allow-media-trim",
    "allow-media-extract-frames"
  ]
}
