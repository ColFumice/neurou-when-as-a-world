+++ b/server/src/SharedServerConfig.ts
@@ -0,0 +1,47 @@
+import { readFile } from 'node:fs/promises';
+import { createHash } from 'node:crypto';
+import { environmentConfig, type ServiceConfig } from './config.js';
+import { keyFingerprint, validatePublicKey } from './crypto.js';
+import { sharedCanonical } from './SharedReceiptSigner.js';
+import type { WorldDeveloperTrustAnchor } from '../.shared-kernel/SharedCommitContracts.js';
+import { SharedCommitCodec } from '../.shared-kernel/SharedCommitCodec.js';
+
+export interface SharedOperatorWorldPin {
+ readonly serviceInstanceId: string;
+ readonly worldId: string;
+ readonly mapId: string;
+ readonly worldDeveloperAccountId: string;
+ readonly developerTrustAnchor: WorldDeveloperTrustAnchor;
+ readonly developerTrustAnchorSha256: string;
+ readonly genesisSha256: string;
+ readonly contentManifestSha256: string;
+}
+export interface SharedServerConfig {
+ readonly auth: ServiceConfig;
+ readonly operatorWorldPins: readonly SharedOperatorWorldPin[];
+ readonly accessCodePepper: Buffer;
+ readonly operatorClockTrustRevision: string;
+}
+export async function sharedEnvironmentConfig(): Promise<SharedServerConfig> {
+ const auth=environmentConfig();
+ if(!process.env.SHARED_OPERATOR_PINS_PATH || !process.env.SHARED_ACCESS_CODE_PEPPER || !process.env.SHARED_CLOCK_TRUST_REVISION) throw new Error('Shared operator pins, code pepper and clock trust revision required');
+ const pepper=Buffer.from(process.env.SHARED_ACCESS_CODE_PEPPER,'base64url');
+ if(pepper.length!==32 || pepper.toString('base64url')!==process.env.SHARED_ACCESS_CODE_PEPPER) throw new Error('Shared code pepper must be 32 canonical random bytes');
+ const input:unknown=JSON.parse(await readFile(process.env.SHARED_OPERATOR_PINS_PATH,'utf8'));
+ if(!Array.isArray(input))throw new Error('Shared operator pins must be an explicit array');
+ const config:SharedServerConfig={auth,operatorWorldPins:input as SharedOperatorWorldPin[],accessCodePepper:pepper,operatorClockTrustRevision:process.env.SHARED_CLOCK_TRUST_REVISION};
+ validateSharedConfig(config);return config;
+}
+export function validateSharedConfig(config:SharedServerConfig):void {
+ const origin=new URL(config.auth.origin);if(config.auth.host!=='127.0.0.1'||origin.origin!==config.auth.origin||origin.protocol!=='http:'||origin.hostname!=='127.0.0.1'||origin.port!==String(config.auth.port)||!Number.isInteger(config.auth.port)||config.auth.port<0||config.auth.port>65535)throw new Error('Shared backend requires exact HTTP IPv4 loopback');
+ if(config.accessCodePepper.length!==32 || !/^[A-Za-z0-9_.:-]{1,128}$/.test(config.operatorClockTrustRevision))throw new Error('Invalid shared operator configuration');
+ const seen=new Set<string>();const codec=new SharedCommitCodec();
+ for(const pin of config.operatorWorldPins){
+  const expected=['serviceInstanceId','worldId','mapId','worldDeveloperAccountId','developerTrustAnchor','developerTrustAnchorSha256','genesisSha256','contentManifestSha256'].sort();
+  if(Object.keys(pin).sort().join('|')!==expected.join('|'))throw new Error('Operator pin fields invalid');
+  const anchor=codec.validate('WorldDeveloperTrustAnchor',pin.developerTrustAnchor);validatePublicKey(anchor.developerPublicKey);
+  if(pin.serviceInstanceId!==config.auth.serviceInstanceId || pin.worldId!==anchor.worldId || pin.worldDeveloperAccountId!==anchor.worldDeveloperAccountId || seen.has(pin.worldId))throw new Error('Operator pin context invalid');
+  if(!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(pin.mapId) || ![pin.developerTrustAnchorSha256,pin.genesisSha256,pin.contentManifestSha256].every(x=>/^[0-9a-f]{64}$/.test(x)))throw new Error('Operator pin digest invalid');
+  if(keyFingerprint(anchor.developerPublicKey)!==anchor.developerPublicKeyFingerprint || createHash('sha256').update(sharedCanonical(anchor)).digest('hex')!==pin.developerTrustAnchorSha256)throw new Error('Operator pin fingerprint invalid');seen.add(pin.worldId);
+ }
+}

diff --git a/server/src/SharedSessionVerifier.ts b/server/src/SharedSessionVerifier.ts
new file mode 100644
--- /dev/null
+++ b/server/src/SharedSessionVerifier.ts
@@ -0,0 +1,30 @@
+import { timingSafeEqual } from 'node:crypto';
+import type { FastifyRequest } from 'fastify';
+import type { PoolClient } from 'pg';
+import type { P256PublicJwk } from './contracts.js';
+import { sha256 } from './crypto.js';
+
+export class SharedServiceFailure extends Error {
+ constructor(readonly detail:string,readonly status:number,readonly code:string,readonly layer='Authority',readonly retryAfterMs:number|null=null){super(detail);}
+}
+export interface SharedSession {
+ readonly accountId:string;readonly deviceId:string;readonly deviceGeneration:number;readonly sessionId:string;
+ readonly signingPublicKey:P256PublicJwk;readonly signingKeyFingerprint:string;
+}
+export class SharedSessionVerifier {
+ async verify(request:FastifyRequest,client:PoolClient,wall:number,additionalTargets:readonly {accountId:string;deviceId:string}[]=[]):Promise<SharedSession>{
+  const token=request.cookies.neurou_access;if(!token||!/^[A-Za-z0-9_-]{43}$/.test(token)||Buffer.from(token,'base64url').toString('base64url')!==token)throw new SharedServiceFailure('SessionMissing',401,'Unauthenticated','Session');
+  const tokenHash=sha256(token);
+  const ids=(await client.query<{account_id:string;device_id:string;session_id:string}>('SELECT f.account_id,f.device_id,f.session_id FROM auth_tokens t JOIN auth_families f USING(session_id) WHERE t.token_hash=$1 AND t.kind=\'Access\'',[tokenHash])).rows[0];
+  if(!ids)throw new SharedServiceFailure('SessionMissing',401,'Unauthenticated','Session');
+  const accounts=[...new Set([ids.account_id,...additionalTargets.map(target=>target.accountId)])].sort();const devices=[...new Set([ids.device_id,...additionalTargets.map(target=>target.deviceId)])].sort();
+  for(const account of accounts)await client.query('SELECT account_id FROM accounts WHERE account_id=$1 FOR UPDATE',[account]);
+  for(const device of devices)await client.query('SELECT device_id FROM devices WHERE device_id=$1 FOR UPDATE',[device]);
+  await client.query('SELECT session_id FROM auth_families WHERE session_id=$1 FOR UPDATE',[ids.session_id]);
+  const row=(await client.query<{revoked:boolean;disabled:boolean;status:string;generation:number;public_key_jwk:P256PublicJwk;key_fingerprint:string;expires_at:string;absolute_expires_at:string;used:boolean;csrf_hash:string}>(`SELECT f.revoked,f.absolute_expires_at,f.csrf_hash,a.disabled,d.status,d.generation,d.public_key_jwk,d.key_fingerprint,t.expires_at,t.used FROM auth_tokens t JOIN auth_families f USING(session_id) JOIN accounts a ON a.account_id=f.account_id JOIN devices d ON d.device_id=f.device_id WHERE t.token_hash=$1 AND t.kind='Access' FOR UPDATE OF t`,[tokenHash])).rows[0];
+  if(!row||row.revoked||row.disabled||row.status!=='Active'||row.used)throw new SharedServiceFailure('SessionRevoked',401,'Unauthenticated','Session');
+  if(Number(row.expires_at)<=wall||Number(row.absolute_expires_at)<=wall)throw new SharedServiceFailure('SessionExpired',401,'Unauthenticated','Session');
+  const csrf=request.headers['x-csrf-token'];if(typeof csrf!=='string'||!/^[A-Za-z0-9_-]{43}$/.test(csrf)||!timingSafeEqual(Buffer.from(sha256(csrf)),Buffer.from(row.csrf_hash)))throw new SharedServiceFailure('CsrfRejected',403,'Forbidden','Session');
+  return {accountId:ids.account_id,deviceId:ids.device_id,deviceGeneration:row.generation,sessionId:ids.session_id,signingPublicKey:row.public_key_jwk,signingKeyFingerprint:row.key_fingerprint};
+ }
+}

diff --git a/server/src/WorldAuthorityService.ts b/server/src/WorldAuthorityService.ts
