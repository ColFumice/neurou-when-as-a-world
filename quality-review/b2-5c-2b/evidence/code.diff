+}
+
+function integerField(raw: unknown, minimum = 0): number {
+  if (typeof raw !== 'number' || !Number.isSafeInteger(raw) || raw < minimum || Object.is(raw, -0)) {
+    throw new ServiceClientFault('InvalidData');
+  }
