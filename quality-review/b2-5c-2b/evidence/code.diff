+    if (unit >= 0xd800 && unit <= 0xdbff) {
+      const next = raw.charCodeAt(++index);
+      if (!(next >= 0xdc00 && next <= 0xdfff)) { throw new ServiceClientFault('InvalidData'); }
+    } else if (unit >= 0xdc00 && unit <= 0xdfff) { throw new ServiceClientFault('InvalidData'); }
+  }
