+CREATE TABLE authority_clock_state (
+ service_instance_id text PRIMARY KEY, generation bigint NOT NULL CHECK(generation > 0 AND generation <= 9007199254740991),
+ last_signed_epoch_ms bigint CHECK(last_signed_epoch_ms >= 0 AND last_signed_epoch_ms <= 9007199254740991),
+ trusted boolean NOT NULL, operator_trust_revision text NOT NULL, ip_failure_counters jsonb NOT NULL DEFAULT '{}'::jsonb
+);
+CREATE TABLE authority_worlds (
+ world_id uuid PRIMARY KEY, service_instance_id text NOT NULL, registration jsonb NOT NULL, root_anchor jsonb NOT NULL,
+ registration_receipt bytea NOT NULL, current_epoch bigint CHECK(current_epoch > 0), admission_revision bigint NOT NULL DEFAULT 0,
+ observer_revision bigint NOT NULL DEFAULT 0, seal_revision bigint NOT NULL DEFAULT 0, sealed_through bigint,
+ CHECK(admission_revision BETWEEN 0 AND 9007199254740991), CHECK(observer_revision BETWEEN 0 AND 9007199254740991),
+ CHECK(seal_revision BETWEEN 0 AND 9007199254740991)
+);
+CREATE TABLE authority_author_sequences (
+ account_id uuid PRIMARY KEY REFERENCES accounts(account_id), next_sequence bigint NOT NULL CHECK(next_sequence BETWEEN 1 AND 9007199254740991)
+);
+CREATE TABLE authority_sequence_segments (
+ segment_id uuid PRIMARY KEY, account_id uuid NOT NULL REFERENCES accounts(account_id), device_id uuid NOT NULL REFERENCES devices(device_id),
+ device_generation bigint NOT NULL, world_id uuid NOT NULL REFERENCES authority_worlds(world_id), membership_epoch bigint NOT NULL,
+ first_sequence bigint NOT NULL CHECK(first_sequence > 0), last_sequence bigint NOT NULL CHECK(last_sequence <= 9007199254740991),
+ issued_at bigint NOT NULL, expires_at bigint NOT NULL, payload jsonb NOT NULL, receipt bytea NOT NULL,
+ CHECK(last_sequence-first_sequence=1023), CHECK(expires_at-issued_at=3600000), UNIQUE(account_id,first_sequence)
+);
+CREATE TABLE authority_requests (
+ service_instance_id text NOT NULL, account_id uuid NOT NULL REFERENCES accounts(account_id), request_nonce text NOT NULL,
+ operation text NOT NULL, world_id uuid, device_id uuid NOT NULL, device_generation bigint NOT NULL, request_sha256 text NOT NULL,
+ result_wire bytea, result_kind text NOT NULL CHECK(result_kind IN ('Accepted','Rejected')), created_at bigint NOT NULL,
+ PRIMARY KEY(service_instance_id,account_id,request_nonce), CHECK(request_sha256 ~ '^[0-9a-f]{64}$')
+);
+CREATE TABLE authority_append_permits (
+ permit_id uuid PRIMARY KEY, world_id uuid NOT NULL REFERENCES authority_worlds(world_id), account_id uuid NOT NULL,
+ author_sequence bigint NOT NULL, device_id uuid NOT NULL, device_generation bigint NOT NULL, segment_id uuid NOT NULL REFERENCES authority_sequence_segments(segment_id),
+ membership_epoch bigint NOT NULL, change_class text NOT NULL, appended_at bigint NOT NULL, expires_at bigint NOT NULL,
+ clock_generation bigint NOT NULL, consumed_sha256 text, payload jsonb NOT NULL, receipt bytea NOT NULL,
+ CHECK(expires_at-appended_at=30000), UNIQUE(account_id,author_sequence)
+);
+CREATE TABLE authority_commit_admissions (
+ account_id uuid NOT NULL, author_sequence bigint NOT NULL, world_id uuid NOT NULL REFERENCES authority_worlds(world_id),
+ admission_revision bigint NOT NULL, envelope_sha256 text NOT NULL CHECK(envelope_sha256 ~ '^[0-9a-f]{64}$'), appended_at bigint NOT NULL,
+ admitted_at bigint NOT NULL, public_header jsonb NOT NULL, payload jsonb NOT NULL, receipt bytea NOT NULL,
+ PRIMARY KEY(account_id,author_sequence), UNIQUE(world_id,admission_revision)
+);
+CREATE TABLE authority_commit_rejections (
+ account_id uuid NOT NULL, author_sequence bigint NOT NULL, world_id uuid NOT NULL REFERENCES authority_worlds(world_id),
+ envelope_sha256 text NOT NULL, reason text NOT NULL CHECK(reason IN ('TimeTooLate','PermitExpired','EpochClosed','IdentityConflict')),
+ payload jsonb NOT NULL, receipt bytea NOT NULL, PRIMARY KEY(account_id,author_sequence,envelope_sha256)
+);
+CREATE TABLE authority_observer_facts (
+ world_id uuid NOT NULL REFERENCES authority_worlds(world_id), account_id uuid NOT NULL REFERENCES accounts(account_id),
+ admission_revision bigint NOT NULL, code_revision bigint NOT NULL, admitted_at bigint NOT NULL, payload jsonb NOT NULL, receipt bytea NOT NULL,
+ PRIMARY KEY(world_id,account_id), UNIQUE(world_id,admission_revision)
+);
+CREATE TABLE authority_agreement_credentials (
+ world_id uuid NOT NULL REFERENCES authority_worlds(world_id), account_id uuid NOT NULL, device_id uuid NOT NULL, device_generation bigint NOT NULL,
+ key_fingerprint text NOT NULL, credential jsonb NOT NULL, challenge_sha256 text NOT NULL, registered_at bigint NOT NULL,
+ binding_receipt bytea NOT NULL, registration_receipt bytea NOT NULL,
+ PRIMARY KEY(world_id,account_id,device_id,device_generation,key_fingerprint)
+);
+CREATE TABLE authority_membership_epochs (
+ world_id uuid NOT NULL REFERENCES authority_worlds(world_id), membership_epoch bigint NOT NULL, change_id uuid UNIQUE NOT NULL,
+ change_sha256 text NOT NULL, proposal jsonb NOT NULL, payload jsonb NOT NULL, activated_at bigint NOT NULL, receipt bytea NOT NULL,
+ PRIMARY KEY(world_id,membership_epoch)
+);
+CREATE TABLE authority_access_codes (
+ world_id uuid PRIMARY KEY REFERENCES authority_worlds(world_id), code_revision bigint NOT NULL, verifier text NOT NULL,
+ failure_counters jsonb NOT NULL DEFAULT '{}'::jsonb, changed_at bigint NOT NULL,
+ CHECK(code_revision BETWEEN 1 AND 9007199254740991), CHECK(verifier ~ '^[0-9a-f]{64}$')
+);
+CREATE TABLE authority_challenges (
+ challenge_id uuid PRIMARY KEY, kind text NOT NULL CHECK(kind IN ('Credential','Observer')), world_id uuid NOT NULL REFERENCES authority_worlds(world_id),
+ account_id uuid NOT NULL, device_id uuid NOT NULL, device_generation bigint NOT NULL, session_id uuid NOT NULL REFERENCES auth_families(session_id),
+ challenge_sha256 text NOT NULL, public_challenge jsonb NOT NULL, challenge_receipt bytea NOT NULL, expires_at bigint NOT NULL,
+ consumed boolean NOT NULL DEFAULT false, expected_tag_sha256 text, terminal_request_sha256 text,
+ CHECK((kind='Credential') = (expected_tag_sha256 IS NOT NULL))
+);
+CREATE TABLE authority_settlement_seals (
+ world_id uuid NOT NULL REFERENCES authority_worlds(world_id), seal_revision bigint NOT NULL, cutoff bigint NOT NULL,
+ payload jsonb NOT NULL, receipt bytea NOT NULL, PRIMARY KEY(world_id,seal_revision), UNIQUE(world_id,cutoff)
+);
+CREATE TABLE relay_streams (
+ world_id uuid PRIMARY KEY REFERENCES authority_worlds(world_id), generation bigint NOT NULL CHECK(generation > 0),
+ next_position numeric(20,0) NOT NULL CHECK(next_position BETWEEN 1 AND 18446744073709551615),
+ retention_floor numeric(20,0) NOT NULL DEFAULT 0 CHECK(retention_floor BETWEEN 0 AND 18446744073709551615)
+);
+CREATE TABLE relay_commit_queue (
+ world_id uuid NOT NULL, generation bigint NOT NULL, position numeric(20,0) NOT NULL CHECK(position BETWEEN 1 AND 18446744073709551615),
+ account_id uuid NOT NULL, author_sequence bigint NOT NULL, envelope_bytes bytea CHECK(octet_length(envelope_bytes)<=65536),
+ public_proof jsonb, envelope_sha256 text NOT NULL, admitted_at bigint NOT NULL, retained_until bigint NOT NULL, tombstone boolean NOT NULL DEFAULT false,
+ receipt bytea NOT NULL, PRIMARY KEY(world_id,generation,position), UNIQUE(account_id,author_sequence),
+ FOREIGN KEY(account_id,author_sequence) REFERENCES authority_commit_admissions(account_id,author_sequence),
+ CHECK(retained_until-admitted_at >= 86400000), CHECK(tombstone OR envelope_bytes IS NOT NULL)
+);
+CREATE TABLE relay_delivery_recipients (
+ world_id uuid NOT NULL, generation bigint NOT NULL, position numeric(20,0) NOT NULL, account_id uuid NOT NULL, device_id uuid NOT NULL,
+ device_generation bigint NOT NULL, PRIMARY KEY(world_id,generation,position,account_id,device_id,device_generation),
+ FOREIGN KEY(world_id,generation,position) REFERENCES relay_commit_queue(world_id,generation,position)
+);
+CREATE TABLE relay_acknowledgements (
+ world_id uuid NOT NULL, generation bigint NOT NULL, position numeric(20,0) NOT NULL, account_id uuid NOT NULL, device_id uuid NOT NULL,
+ device_generation bigint NOT NULL, confirmation_sha256 text NOT NULL, receipt bytea NOT NULL,
+ PRIMARY KEY(world_id,generation,position,account_id,device_id,device_generation),
+ FOREIGN KEY(world_id,generation,position,account_id,device_id,device_generation)
+ REFERENCES relay_delivery_recipients(world_id,generation,position,account_id,device_id,device_generation)
+);

diff --git a/server/src/AuthorityRoute.ts b/server/src/AuthorityRoute.ts
new file mode 100644
--- /dev/null
+++ b/server/src/AuthorityRoute.ts
@@ -0,0 +1,36 @@
+import type { FastifyInstance,FastifyRequest } from 'fastify';
+import { SharedServiceProtocolCodec } from '../.shared-kernel/SharedServiceProtocolCodec.js';
+import { SharedCanonicalBytes,SharedSchemaError } from '../.shared-kernel/SharedCanonicalBytes.js';
+import type { SharedProtocolOperation } from '../.shared-kernel/SharedServiceProtocolContracts.js';
+import type { WorldAuthorityService } from './WorldAuthorityService.js';
+import { SharedServiceFailure } from './SharedSessionVerifier.js';
+
+const operations:readonly [SharedProtocolOperation,number][]=[['/status',16384],['/world/register',32768],['/world/facts',16384],['/credential/challenge',32768],['/credential/register',32768],['/access-code/set',16384],['/observer/challenge',16384],['/observer/redeem',16384],['/membership/publish',524288],['/membership/read',16384],['/sequence/allocate',16384],['/append/permit',32768],['/commit/admit',65536],['/commit/admission',16384],['/settlement/seal',16384]];
+function schemaFailure(error:SharedSchemaError,request:FastifyRequest):SharedServiceFailure {
+ if(error.code==='CanonicalInvalid')return new SharedServiceFailure('CanonicalInvalid',400,'InvalidData');
+ if(error.code==='LimitExceeded')return new SharedServiceFailure('ResourceLimit',413,'InvalidData');
+ // Version classification follows a complete strict canonical decode, never JSON.parse or a duplicate-key projection.
+ try{
+  const value=SharedCanonicalBytes.decode(SharedCanonicalBytes.utf8(request.body as string));
+  if(value!==null&&typeof value==='object'&&!Array.isArray(value)){
+   const version=(value as Record<string,unknown>).schemaVersion;
+   if(typeof version==='number'&&Number.isSafeInteger(version)&&version!==1)return new SharedServiceFailure('VersionUnsupported',400,'VersionUnsupported');
+  }
+ }catch{}
+ return new SharedServiceFailure('SchemaInvalid',400,'InvalidData');
+}
+/** Encapsulation preserves every old b guard/error route unchanged. Only this child parser retains canonical raw bytes. */
+export async function authorityRoutes(app:FastifyInstance,service:WorldAuthorityService):Promise<void>{
+ app.removeContentTypeParser('application/json');app.addContentTypeParser('application/json',{parseAs:'string'},(_request,text,done)=>done(null,text));
+ app.setErrorHandler((error,request,reply)=>{
+  const e=error as Error&{statusCode?:number;status?:number;code?:string};
+  const legacy=e.constructor.name==='Fault'&&['Forbidden','RateLimited','InvalidData','Unauthenticated','AuthorityUnavailable'].includes(String(e.code));
+  const fault=error instanceof SharedServiceFailure?error:error instanceof SharedSchemaError?schemaFailure(error,request):legacy&&e.code==='Forbidden'?new SharedServiceFailure('OriginRejected',403,'Forbidden'):legacy&&e.code==='RateLimited'?new SharedServiceFailure('RateLimitExceeded',429,'RateLimited','Authority',60000):legacy&&e.code==='InvalidData'?new SharedServiceFailure('SchemaInvalid',400,'InvalidData'):new SharedServiceFailure(e.statusCode===413?'ResourceLimit':'ServiceUnavailable',e.statusCode===413?413:503,e.statusCode===413?'InvalidData':'AuthorityUnavailable');
+  let nonce:string|null=null;try{const input=SharedServiceProtocolCodec.parseRequest(request.url.slice('/api/v1/shared'.length) as SharedProtocolOperation,request.body as string);nonce=input.requestNonce;}catch{}
+  reply.code(fault.status).type('application/json').send(SharedServiceProtocolCodec.encode({kind:'Rejected',fault:{code:fault.code,layer:fault.layer,detail:fault.detail,requestId:request.id,requestNonce:nonce,retryAfterMs:fault.retryAfterMs}}));
+ });
+ for(const [operation,bodyLimit] of operations)app.post<{Body:string}>('/api/v1/shared'+operation,{bodyLimit},async(request,reply)=>{
+  const raw=request.body;const input=SharedServiceProtocolCodec.parseRequest(operation,raw);
+  const result=await service.handle(operation,input as never,raw,request as FastifyRequest);return reply.code(result.status).type('application/json').send(result.wire);
+ });
+}

diff --git a/server/src/RealAuthorityClock.ts b/server/src/RealAuthorityClock.ts
new file mode 100644
--- /dev/null
+++ b/server/src/RealAuthorityClock.ts
@@ -0,0 +1,33 @@
+import { performance } from 'node:perf_hooks';
+import type { Pool,PoolClient } from 'pg';
+import type { SharedServerConfig } from './SharedServerConfig.js';
+
+export interface AuthorityClockSample {readonly trusted:boolean;readonly epochMs:number|null;readonly lastSignedEpochMs:number|null;readonly generation:number;}
+export interface IsolatedClockSource {wall():number;monotonic():number;}
+export class RealAuthorityClock {
+ private previousWall:number;private previousMono:number;private trusted:boolean;private floor:number|null=null;private generation=0;
+ private constructor(private readonly instance:string,initialTrusted:boolean,private readonly revision:string,private readonly source:IsolatedClockSource){this.previousWall=source.wall();this.previousMono=source.monotonic();this.trusted=initialTrusted;}
+ static production(config:SharedServerConfig):RealAuthorityClock{return new RealAuthorityClock(config.auth.serviceInstanceId,config.auth.clockInitiallyTrusted,config.operatorClockTrustRevision,{wall:()=>Date.now(),monotonic:()=>performance.now()});}
+ /** Explicit isolated-test capability; the production entry never accepts a source/environment clock. */
+ static isolatedTest(instance:string,revision:string,source:IsolatedClockSource):RealAuthorityClock{return new RealAuthorityClock(instance,true,revision,source);}
+ async initialize(pool:Pool):Promise<void>{
+  const client=await pool.connect();try{await client.query('BEGIN');
+   await client.query('SELECT pg_advisory_xact_lock(253602)');const generation=Number((await client.query<{generation:string}>("SELECT nextval('service_clock_generation') AS generation")).rows[0]!.generation);
+   if(!Number.isSafeInteger(generation)||generation<1)throw new Error('Clock generation exhausted');this.generation=generation;
+   const row=(await client.query<{last_signed_epoch_ms:string|null;trusted:boolean;operator_trust_revision:string}>('SELECT * FROM authority_clock_state WHERE service_instance_id=$1 FOR UPDATE',[this.instance])).rows[0];
+   if(row){this.floor=row.last_signed_epoch_ms===null?null:Number(row.last_signed_epoch_ms);this.trusted=this.trusted&&(row.trusted||row.operator_trust_revision!==this.revision);}
+   if(this.floor!==null&&this.previousWall<this.floor)this.trusted=false;
+   await client.query(`INSERT INTO authority_clock_state(service_instance_id,generation,last_signed_epoch_ms,trusted,operator_trust_revision) VALUES($1,$2,$3,$4,$5) ON CONFLICT(service_instance_id) DO UPDATE SET generation=EXCLUDED.generation,trusted=EXCLUDED.trusted,operator_trust_revision=EXCLUDED.operator_trust_revision`,[this.instance,generation,this.floor,this.trusted,this.revision]);await client.query('COMMIT');
+  }catch(error){await client.query('ROLLBACK');throw error;}finally{client.release();}
+ }
+ async sample(client:PoolClient):Promise<AuthorityClockSample>{
+  const row=(await client.query<{generation:string;trusted:boolean;last_signed_epoch_ms:string|null}>('SELECT generation,trusted,last_signed_epoch_ms FROM authority_clock_state WHERE service_instance_id=$1 FOR UPDATE',[this.instance])).rows[0];
+  if(!row)throw new Error('Clock uninitialized');const wall=this.source.wall(),mono=this.source.monotonic();const floor=row.last_signed_epoch_ms===null?null:Number(row.last_signed_epoch_ms);
+  if(Number(row.generation)!==this.generation||!row.trusted||!Number.isSafeInteger(wall)||wall<0||wall<this.previousWall||(floor!==null&&wall<floor)||Math.abs((wall-this.previousWall)-(mono-this.previousMono))>2000)this.trusted=false;
+  this.previousWall=wall;this.previousMono=mono;
+  if(this.trusted)this.floor=wall;else this.floor=floor;
+  await client.query('UPDATE authority_clock_state SET trusted=$2,last_signed_epoch_ms=$3 WHERE service_instance_id=$1 AND generation=$4',[this.instance,this.trusted,this.floor,this.generation]);
+  return {trusted:this.trusted,epochMs:this.trusted?wall:null,lastSignedEpochMs:this.floor,generation:this.generation};
+ }
+ async persistLatch(pool:Pool):Promise<void>{if(!this.trusted)await pool.query('UPDATE authority_clock_state SET trusted=false WHERE service_instance_id=$1 AND generation=$2',[this.instance,this.generation]);}
+}

diff --git a/server/src/SharedCryptoProof.ts b/server/src/SharedCryptoProof.ts
new file mode 100644
--- /dev/null
+++ b/server/src/SharedCryptoProof.ts
@@ -0,0 +1,16 @@
+import { createCipheriv,createHmac,createPublicKey,diffieHellman,generateKeyPairSync,hkdfSync,randomBytes } from 'node:crypto';
+import { publicJwk,sha256 } from './crypto.js';
+import { sharedCanonical } from './SharedReceiptSigner.js';
+import type { WorldMemberCredential } from '../.shared-kernel/SharedCommitContracts.js';
+
+export function makeCredentialChallenge(context:{schemaVersion:1;serviceInstanceId:string;worldId:string;challengeId:string;requestNonce:string;recipient:WorldMemberCredential;developerTrustAnchorSha256:string;challengeNonceBase64Url:string;expiresAtServerEpochMs:number}):{challenge:Record<string,unknown>;expectedTagSha256:string}{
+ const ephemeral=generateKeyPairSync('ec',{namedCurve:'prime256v1'});const ephemeralKeyAgreementPublicKey=publicJwk(ephemeral.privateKey);
+ const z=diffieHellman({privateKey:ephemeral.privateKey,publicKey:createPublicKey({key:{...context.recipient.keyAgreementPublicKey},format:'jwk'})});
+ const salt=randomBytes(32),nonce=randomBytes(12),secret=randomBytes(32);
+ const key=Buffer.from(hkdfSync('sha256',z,salt,Buffer.from('Neurou/world-member-credential-proof-key/v1\0'+sharedCanonical(context)),32));
+ const aad=Buffer.from('Neurou/world-member-credential-proof-aad/v1\0'+sharedCanonical({context,ephemeralKeyAgreementPublicKey,saltBase64Url:salt.toString('base64url')}));
+ const cipher=createCipheriv('aes-256-gcm',key,nonce);cipher.setAAD(aad);const encrypted=Buffer.concat([cipher.update(secret),cipher.final(),cipher.getAuthTag()]);
+ const challenge={context,ephemeralKeyAgreementPublicKey,saltBase64Url:salt.toString('base64url'),nonceBase64Url:nonce.toString('base64url'),ciphertextAndTagBase64Url:encrypted.toString('base64url')};
+ const tag=createHmac('sha256',secret).update('Neurou/world-member-credential-possession/v1\0'+sharedCanonical(challenge)).digest();const expectedTagSha256=sha256(tag);
+ z.fill(0);key.fill(0);secret.fill(0);tag.fill(0);return{challenge,expectedTagSha256};
+}

diff --git a/server/src/SharedMigrationRunner.ts b/server/src/SharedMigrationRunner.ts
new file mode 100644
--- /dev/null
+++ b/server/src/SharedMigrationRunner.ts
@@ -0,0 +1,42 @@
+import { readFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import type { Pool } from 'pg';
+import { sha256 } from './crypto.js';
+
+const ORIGINAL_001_SHA256='5468eb425557c8ca1be6c5fb969dbd5bb038e7715b10e9f4842ea15859a30d13';
+const BASE_COLUMNS:Readonly<Record<string,readonly string[]>>={
+ accounts:['account_id','account_name','password_hash','created_at','disabled'],
+ devices:['device_id','account_id','generation','key_fingerprint','public_key_jwk','label','assurance','status','created_at'],
+ auth_families:['session_id','account_id','device_id','csrf_hash','absolute_expires_at','revoked','created_at'],
+ auth_tokens:['token_hash','session_id','kind','expires_at','used'],
+ device_challenges:['challenge_id','purpose','account_name','device_id','public_key_jwk','key_fingerprint','challenge_data','expires_at','consumed','owner_session_id'],
+ lightweight_requests:['account_id','request_id','operation','request_digest','result'],
+};
+export class SharedMigrationRunner {
+ async migrate(pool:Pool,serverDirectory=process.cwd()):Promise<void>{
+  const first=await readFile(resolve(serverDirectory,'migrations/001.sql'),'utf8');const second=await readFile(resolve(serverDirectory,'sql/002_shared_authority.sql'),'utf8');
+  if(sha256(first)!==ORIGINAL_001_SHA256)throw new Error('Protected 001 checksum mismatch');
+  const client=await pool.connect();try{
+   if(Math.floor(Number((await client.query<{server_version_num:string}>('SHOW server_version_num')).rows[0]!.server_version_num)/10000)!==17)throw new Error('PostgreSQL 17 required');
+   await client.query('SELECT pg_advisory_lock(253601)');
+   const exists=(await client.query<{exists:boolean}>("SELECT to_regclass('public.service_schema_versions') IS NOT NULL AS exists")).rows[0]!.exists;
+   if(!exists){const partial=(await client.query<{exists:boolean}>("SELECT to_regclass('public.accounts') IS NOT NULL AS exists")).rows[0]!.exists;if(partial)throw new Error('Partial legacy schema rejected');await client.query(first);}
+   const versions=(await client.query<{version:number}>('SELECT version FROM service_schema_versions ORDER BY version')).rows.map(row=>row.version);
+   if(versions.join(',')!=='1'&&versions.join(',')!=='1,2')throw new Error('Unsupported legacy schema version');
+   for(const [table,expected] of Object.entries(BASE_COLUMNS)){
+    const columns=(await client.query<{column_name:string}>("SELECT column_name FROM information_schema.columns WHERE table_schema='public' AND table_name=$1 ORDER BY ordinal_position",[table])).rows.map(row=>row.column_name);
+    if(columns.join('|')!==expected.join('|'))throw new Error('Legacy schema drift rejected');
+   }
+   await client.query('BEGIN');
+   const checksumColumn=(await client.query("SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='service_schema_versions' AND column_name='source_sha256'")).rowCount;
+   if(!checksumColumn)await client.query('ALTER TABLE service_schema_versions ADD COLUMN source_sha256 text');
+   const one=(await client.query<{source_sha256:string|null}>('SELECT source_sha256 FROM service_schema_versions WHERE version=1 FOR UPDATE')).rows[0]!;
+   if(one.source_sha256!==null&&one.source_sha256!==ORIGINAL_001_SHA256)throw new Error('Recorded 001 checksum mismatch');
+   await client.query('UPDATE service_schema_versions SET source_sha256=$1 WHERE version=1',[ORIGINAL_001_SHA256]);
+   if(versions.includes(2)){
+    if((await client.query<{source_sha256:string}>('SELECT source_sha256 FROM service_schema_versions WHERE version=2')).rows[0]!.source_sha256!==sha256(second))throw new Error('002 checksum mismatch');
+   }else{await client.query(second);await client.query('INSERT INTO service_schema_versions(version,source_sha256) VALUES(2,$1)',[sha256(second)]);}
+   await client.query('COMMIT');
+  }catch(error){await client.query('ROLLBACK').catch(()=>undefined);throw error;}finally{await client.query('SELECT pg_advisory_unlock(253601)').catch(()=>undefined);client.release();}
+ }
+}

