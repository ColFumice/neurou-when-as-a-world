+function addBox(
+  parent: Node,
+  name: string,
+  size: { readonly w: number; readonly h: number; readonly l: number },
+  tint: Color,
+  xyz: { readonly x: number; readonly y: number; readonly z: number },
+  rotY: number = 0,
+  desaturationCollector?: Array<{ material: Material; originalColor: Color }>,
