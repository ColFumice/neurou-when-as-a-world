+  /** Validate every available section before constructing or activating the new graph. */
+  private async prepareCoreRuntime(): Promise<void> {
+    const identity = this.worldIdentity;
+    if (!identity) { return; }
+    try {
+      const regularPath = this.UseGuidanceChart ? this.ChartResourcePath.trim() : 'chart/chart_placeholder';
+      const [contentAsset, regularAsset] = await Promise.all([
+        this.loadJson('world/primary-rain-dialogue'), this.UseGuidanceChart ? this.loadJson(regularPath)
+          : this.loadJson(regularPath).catch(() => null),
+      ]);
+      if (!isValid(this, true)) { return; }
+      const content = parseWorldNarrativeContent(contentAsset.json);
+      const regular = this.UseGuidanceChart ? parseGuidanceChart(regularAsset!.json, this.keyboardLayout)
+        : parseChartData(regularAsset?.json, this.keyboardLayout.layoutVersion) ??
+          createFallbackChartData(this.keyboardLayout.layoutVersion);
+      if (!regular) { throw new Error('恢复所需常规谱面身份缺失'); }
+      this.regularChartId = regular.chartId;
+      this.chartData = regular; this.chartDataResolved = true;
+      const codec = createPrimaryWorldStateCodec(identity.accountId, identity.worldId, content, regular.chartId);
+      this.stateCodec = codec;
+      identity.coreStorage.bindValidator((raw, accountId, worldId) => codec.parse(raw, accountId, worldId));
+      this.coreSnapshot = identity.coreStorage.readValidatedCoreState(identity.accountId, identity.worldId);
+      if (this.coreSnapshot?.sections.Ledger && !this.coreSnapshot.sections.PuzzleProgress?.length) {
+        throw new Error('UnsupportedBoundary: 账本已保存，但尚无稳定解谜检查点；不能重建默认防重状态');
