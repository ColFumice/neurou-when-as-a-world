-  /** Validate every available section before constructing or activating the new graph. */
-  private async prepareCoreRuntime(): Promise<void> {
-    const identity = this.worldIdentity;
-    if (!identity) { return; }
-    try {
-      const regularPath = this.UseGuidanceChart ? this.ChartResourcePath.trim() : 'chart/chart_placeholder';
-      const [contentAsset, regularAsset] = await Promise.all([
-        this.loadJson('world/primary-rain-dialogue'), this.UseGuidanceChart ? this.loadJson(regularPath)
-          : this.loadJson(regularPath).catch(() => null),
-      ]);
-      if (!isValid(this, true)) { return; }
-      const content = parseWorldNarrativeContent(contentAsset.json);
-      const regular = this.UseGuidanceChart ? parseGuidanceChart(regularAsset!.json, this.keyboardLayout)
-        : parseChartData(regularAsset?.json, this.keyboardLayout.layoutVersion) ??
-          createFallbackChartData(this.keyboardLayout.layoutVersion);
-      if (!regular) { throw new Error('恢复所需常规谱面身份缺失'); }
-      this.regularChartId = regular.chartId;
-      this.chartData = regular; this.chartDataResolved = true;
-      const hydration = new LedgerHydration({ accountId: identity.accountId, worldId: identity.worldId,
-        worldKind: content.worldKind, protagonistCharacterId: content.protagonistCharacterId }, content);
-      identity.coreStorage.bindValidator((raw, accountId, worldId) => {
-        let events: readonly NarrativeEvent[] = [];
-        const codec = new WorldStateCodec({
-          Ledger: value => {
-            const ledger = hydration.validate(value);
-            events = ledger.characters.find(character => character.characterId === content.protagonistCharacterId)!.events;
-            return ledger;
-          },
-          PuzzleProgress: value => validatePuzzleProgressSnapshot(value, accountId, worldId,
-            this.chainId, this.deepTraceId, this.regularChartId, events),
-        });
-        const snapshot = codec.parse(raw, accountId, worldId);
-        if (snapshot.worldKind !== 'Primary' && snapshot.worldKind !== 'Unavailable') {
-          throw new Error('已保存世界种类与正式 Primary 内容不匹配');
-        }
-        if (snapshot.sections.PuzzleProgress !== null &&
-            (snapshot.sections.Ledger === null || snapshot.sections.PuzzleProgress.length !== 1)) {
-          throw new Error('本世界解谜载荷须与唯一账本及正式解谜链同时装配');
-        }
-        return snapshot;
-      });
-      this.coreSnapshot = identity.coreStorage.readValidatedCoreState(identity.accountId, identity.worldId);
-      if (this.coreSnapshot?.sections.Ledger && !this.coreSnapshot.sections.PuzzleProgress?.length) {
-        throw new Error('UnsupportedBoundary: 账本已保存，但尚无稳定解谜检查点；不能重建默认防重状态');
-      }
-      this.restoredCore = this.coreSnapshot?.sections.Ledger !== null && this.coreSnapshot?.sections.Ledger !== undefined;
-      this.preparedContent = content;
-      this.buildWorldRuntime();
-    } catch (error: unknown) { this.showCoreError(error); }
-  }
