+      this.restoredCore = this.coreSnapshot?.sections.Ledger !== null && this.coreSnapshot?.sections.Ledger !== undefined;
+      this.preparedContent = content;
+      this.buildWorldRuntime();
+    } catch (error: unknown) { this.showCoreError(error); }
+  }
