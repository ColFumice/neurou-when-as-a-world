+    const notice = document.createElement('p'); notice.id = 'world-core-error';
+    notice.textContent = '世界记忆未能恢复；原数据保留：' + (error instanceof Error ? error.message : String(error));
+    notice.style.cssText = 'position:fixed;inset:30% 15% auto;padding:25px;background:#172735;color:#ffd3ac;z-index:200;font:18px/1.6 system-ui';
+    document.body.appendChild(notice);
