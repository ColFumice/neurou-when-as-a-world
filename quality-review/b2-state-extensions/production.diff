-  private loadJson(path: string): Promise<JsonAsset> {
-    return new Promise<JsonAsset>((resolve, reject) => resources.load(path, JsonAsset,
-      (error, asset) => error || !asset ? reject(error ?? new Error('资源缺失：' + path)) : resolve(asset)));
-  }
