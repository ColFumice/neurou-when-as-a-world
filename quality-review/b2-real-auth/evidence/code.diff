+ }
+ const anchor=await cli('trust-anchor');assert.equal(anchor.serviceInstanceId,serviceInstanceId);const accountName='process_'+randomUUID().replaceAll('-','');const password=randomToken();const created=await cli('account-create',[accountName],{ACCOUNT_PASSWORD:password});assert.equal(created.accountName,accountName);
