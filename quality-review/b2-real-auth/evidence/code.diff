+ async function post(path:string,body:object):Promise<any>{
+  const response=await fetch(origin+path,{method:'POST',headers:{Origin:origin,'Content-Type':'application/json',...(cookieHeader?{Cookie:cookieHeader}:{}),...(csrf?{'X-CSRF-Token':csrf}:{})},body:JSON.stringify(body)});assert.equal(response.status,200);const cookies=response.headers.getSetCookie();if(cookies.length)cookieHeader=cookies.map(value=>value.split(';')[0]!).join('; ');return await response.json();
