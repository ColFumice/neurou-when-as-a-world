@@ -0,0 +1,20 @@
+import { existsSync } from 'node:fs';
+import { buildApp } from './app.js';
+import { environmentConfig } from './config.js';
+import { loadSigner } from './crypto.js';
+import { createPool } from './db.js';
+let shutdown:(()=>Promise<void>)|undefined;
+try {
+ if (existsSync('.env')) process.loadEnvFile('.env');
+ const config = environmentConfig(); const pool = createPool(config.databaseUrl);
+ shutdown=()=>pool.end();
+ const signer = await loadSigner(config.serviceInstanceId,config.signingKeyPath);
+ const app = await buildApp(config,pool,signer);
+ shutdown=async()=>{await app.close();await pool.end();};
+ await app.listen({host:config.host,port:config.port});
+ process.stdout.write(`Neurou ExternalService listening at ${config.origin}; clock=${config.clockInitiallyTrusted?'operator-trusted':'untrusted'}\n`);
+ for(const signal of ['SIGINT','SIGTERM'] as const) process.once(signal,()=>{void shutdown?.().then(()=>process.exit(0));});
+} catch {
+ process.stderr.write('ExternalService startup failed; verify private configuration, database schema, signing key and loopback port.\n');
+ await shutdown?.().catch(()=>undefined);process.exitCode=1;
+}

diff --git a/server/src/strict-json.ts b/server/src/strict-json.ts
new file mode 100644
--- /dev/null
+++ b/server/src/strict-json.ts
@@ -0,0 +1,31 @@
+/** JSON grammar parser rejects duplicate keys before JSON.parse can erase them. */
+export function parseStrictJson(text: string): unknown {
+ let i = 0;
+ function whitespace(): void { while (/[\x20\x09\x0a\x0d]/.test(text[i] ?? '') && i < text.length) i++; }
+ function string(): string {
+  const start = i++;
+  while (i < text.length) {
+   const char = text[i++];
+   if (char === '"') { const value = JSON.parse(text.slice(start, i)) as string; if (/[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/u.test(value)) throw new Error('Invalid Unicode'); return value; }
+   if (char === '\\') i++;
+  }
+  throw new Error('Unterminated string');
+ }
+ function value(depth = 0): void {
+  if (depth > 32) throw new Error('Too deeply nested');
+  whitespace(); const char = text[i];
+  if (char === '"') { string(); return; }
+  if (char === '{') {
+   i++; whitespace(); const keys = new Set<string>(); if (text[i] === '}') { i++; return; }
+   for (;;) { whitespace(); if (text[i] !== '"') throw new Error('Object key required'); const key = string(); if (keys.has(key)) throw new Error('Duplicate key'); keys.add(key); whitespace(); if (text[i++] !== ':') throw new Error('Colon required'); value(depth + 1); whitespace(); const next = text[i++]; if (next === '}') return; if (next !== ',') throw new Error('Invalid object'); }
+  }
+  if (char === '[') {
+   i++; whitespace(); if (text[i] === ']') { i++; return; }
+   for (;;) { value(depth + 1); whitespace(); const next = text[i++]; if (next === ']') return; if (next !== ',') throw new Error('Invalid array'); }
+  }
+  const match = /^(?:true|false|null|-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?)/.exec(text.slice(i));
+  if (!match) throw new Error('Invalid value'); i += match[0].length;
+  if (/^-?\d/.test(match[0]) && !Number.isSafeInteger(Number(match[0]))) throw new Error('Unsafe number');
+ }
+ value(); whitespace(); if (i !== text.length) throw new Error('Trailing data'); return JSON.parse(text) as unknown;
+}

