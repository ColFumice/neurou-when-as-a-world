+  return hexDigest(bytes);
+}
+
+async function textDigest(value: string): Promise<string> {
+  return hexDigest(new TextEncoder().encode(value));
+}
+
+async function hexDigest(bytes: Uint8Array): Promise<string> {
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', bytes));
+  let result = '';
+  for (const byte of digest) { result += byte.toString(16).padStart(2, '0'); }
+  return result;
