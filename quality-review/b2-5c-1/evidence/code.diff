--- /dev/null
+++ b/src/director/SharedCanonicalBytes.ts
@@ -0,0 +1,290 @@
+import type { SharedSchemaErrorCode } from './SharedCommitContracts';
+
+/** Schema failures are data-boundary outcomes, never successful partial parsing. */
+export class SharedSchemaError extends Error {
+  constructor(readonly code: SharedSchemaErrorCode, message: string = code) {
+    super(message);
+    this.name = 'SharedSchemaError';
+    Object.setPrototypeOf(this, SharedSchemaError.prototype);
+  }
+}
+
+const BASE64_URL_ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
+const CANONICAL_DEPTH_LIMIT = 128;
+
+function invalid(message: string): never {
+  throw new SharedSchemaError('CanonicalInvalid', message);
+}
+
+function scalarString(value: string): void {
+  for (let index = 0; index < value.length; index += 1) {
+    const code = value.charCodeAt(index);
+    if (code >= 0xd800 && code <= 0xdbff) {
+      const next = value.charCodeAt(index + 1);
+      if (next < 0xdc00 || next > 0xdfff || !Number.isFinite(next)) { invalid('Unpaired Unicode surrogate'); }
+      index += 1;
+    } else if (code >= 0xdc00 && code <= 0xdfff) { invalid('Unpaired Unicode surrogate'); }
+  }
+}
+
+function descriptors(value: object): { [key: string]: PropertyDescriptor } {
+  if (Object.getOwnPropertySymbols(value).length !== 0) { invalid('Symbol property'); }
+  return Object.getOwnPropertyDescriptors(value);
+}
+
+function canonical(value: unknown, ancestors: Set<object>, depth: number): string {
+  if (depth > CANONICAL_DEPTH_LIMIT) { throw new SharedSchemaError('LimitExceeded', 'Canonical nesting limit'); }
+  if (value === null) { return 'null'; }
+  if (typeof value === 'boolean') { return value ? 'true' : 'false'; }
+  if (typeof value === 'number') {
+    if (!Number.isSafeInteger(value) || Object.is(value, -0)) { invalid('Expected safe integer without negative zero'); }
+    return String(value);
+  }
+  if (typeof value === 'string') { scalarString(value); return JSON.stringify(value); }
+  if (typeof value !== 'object') { invalid('Unsupported JSON value'); }
+  if (ancestors.has(value)) { invalid('Cyclic JSON value'); }
+  ancestors.add(value);
+  const properties = descriptors(value);
+  let result: string;
+  if (Array.isArray(value)) {
+    if (Object.getPrototypeOf(value) !== Array.prototype) { invalid('Unsupported array prototype'); }
+    const length = properties.length;
+    if (!length || !('value' in length) || !Number.isSafeInteger(length.value) || length.value < 0) {
+      invalid('Invalid array length');
+    }
+    if (Object.keys(properties).length !== length.value + 1) { invalid('Sparse array or extra array property'); }
+    const items: string[] = [];
+    for (let index = 0; index < length.value; index += 1) {
+      const property = properties[String(index)];
+      if (!property || !('value' in property) || !property.enumerable) { invalid('Array accessor or missing element'); }
+      items.push(canonical(property.value, ancestors, depth + 1));
+    }
+    result = '[' + items.join(',') + ']';
+  } else {
+    const prototype = Object.getPrototypeOf(value);
+    if (prototype !== Object.prototype && prototype !== null) { invalid('Unsupported object prototype'); }
+    const items: string[] = [];
+    for (const key of Object.keys(properties).sort()) {
+      scalarString(key);
+      const property = properties[key];
+      if (!('value' in property) || !property.enumerable) { invalid('Object accessor or non-enumerable property'); }
+      items.push(JSON.stringify(key) + ':' + canonical(property.value, ancestors, depth + 1));
+    }
+    result = '{' + items.join(',') + '}';
+  }
+  ancestors.delete(value);
+  return result;
+}
+
+/** Small JSON parser keeps duplicate keys visible before any ordinary object exists. */
+class SharedJsonReader {
+  private position = 0;
+  constructor(private readonly source: string) {}
+
+  read(): unknown {
+    const result = this.value(0);
+    this.space();
+    if (this.position !== this.source.length) { invalid('Trailing JSON input'); }
+    return result;
+  }
+
+  private space(): void {
+    while (' \t\r\n'.indexOf(this.source.charAt(this.position)) >= 0 && this.position < this.source.length) {
+      this.position += 1;
+    }
+  }
+
+  private value(depth: number): unknown {
+    if (depth > CANONICAL_DEPTH_LIMIT) { throw new SharedSchemaError('LimitExceeded', 'JSON nesting limit'); }
+    this.space();
+    const first = this.source.charAt(this.position);
+    if (first === '"') { return this.string(); }
+    if (first === '{') {
+      this.position += 1;
+      const result: { [key: string]: unknown } = Object.create(null) as { [key: string]: unknown };
+      const keys = new Set<string>();
+      this.space();
+      if (this.source.charAt(this.position) === '}') { this.position += 1; return result; }
+      while (true) {
+        this.space();
+        if (this.source.charAt(this.position) !== '"') { invalid('Expected JSON object key'); }
+        const key = this.string();
+        if (keys.has(key)) { invalid('Duplicate JSON key'); }
+        keys.add(key);
+        this.space();
+        if (this.source.charAt(this.position) !== ':') { invalid('Expected JSON colon'); }
+        this.position += 1;
+        Object.defineProperty(result, key, { value: this.value(depth + 1), enumerable: true, writable: true, configurable: true });
+        this.space();
+        const separator = this.source.charAt(this.position++);
+        if (separator === '}') { return result; }
+        if (separator !== ',') { invalid('Expected JSON object separator'); }
+      }
+    }
+    if (first === '[') {
+      this.position += 1;
+      const result: unknown[] = [];
+      this.space();
+      if (this.source.charAt(this.position) === ']') { this.position += 1; return result; }
+      while (true) {
+        result.push(this.value(depth + 1));
+        this.space();
+        const separator = this.source.charAt(this.position++);
+        if (separator === ']') { return result; }
+        if (separator !== ',') { invalid('Expected JSON array separator'); }
+      }
+    }
+    for (const entry of [{ text: 'true', value: true }, { text: 'false', value: false }, { text: 'null', value: null }]) {
+      if (this.source.slice(this.position, this.position + entry.text.length) === entry.text) {
+        this.position += entry.text.length;
+        return entry.value;
+      }
+    }
+    const match = /^-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?/.exec(this.source.slice(this.position));
+    if (!match) { invalid('Invalid JSON value'); }
+    this.position += match[0].length;
+    const number = Number(match[0]);
+    if (!Number.isSafeInteger(number) || Object.is(number, -0)) { invalid('Invalid integer JSON value'); }
+    return number;
+  }
+
+  private string(): string {
+    this.position += 1;
+    let result = '';
+    while (this.position < this.source.length) {
+      const character = this.source.charAt(this.position++);
+      if (character === '"') { scalarString(result); return result; }
+      if (character.charCodeAt(0) < 0x20) { invalid('Unescaped JSON control character'); }
+      if (character !== '\\') { result += character; continue; }
+      const escape = this.source.charAt(this.position++);
+      const escapes: { [key: string]: string } = { '"': '"', '\\': '\\', '/': '/', b: '\b', f: '\f', n: '\n', r: '\r', t: '\t' };
+      if (Object.prototype.hasOwnProperty.call(escapes, escape)) { result += escapes[escape]; continue; }
+      if (escape !== 'u') { invalid('Invalid JSON string escape'); }
+      const hex = this.source.slice(this.position, this.position + 4);
+      if (!/^[0-9a-fA-F]{4}$/.test(hex)) { invalid('Invalid Unicode escape'); }
+      result += String.fromCharCode(parseInt(hex, 16));
+      this.position += 4;
+    }
+    return invalid('Unterminated JSON string');
+  }
+}
+
+function assertBytes(bytes: Uint8Array): void {
+  if (!(bytes instanceof Uint8Array) || Object.getPrototypeOf(bytes) !== Uint8Array.prototype) {
+    invalid('Expected direct Uint8Array');
+  }
+}
+
+/** Pure byte boundary: no platform codecs, network, clocks or crypto implementation. */
+export class SharedCanonicalBytes {
+  static encode(value: unknown): Uint8Array {
+    return SharedCanonicalBytes.utf8(canonical(value, new Set<object>(), 0));
+  }
+
+  static decode(bytes: Uint8Array): unknown {
+    const source = SharedCanonicalBytes.text(bytes);
+    const result = new SharedJsonReader(source).read();
+    if (!SharedCanonicalBytes.equalBytes(bytes, SharedCanonicalBytes.encode(result))) { invalid('Non-canonical JSON bytes'); }
+    return result;
+  }
+
+  static utf8(text: string): Uint8Array {
+    if (typeof text !== 'string') { invalid('Expected text'); }
+    scalarString(text);
+    const bytes: number[] = [];
+    for (let index = 0; index < text.length; index += 1) {
+      let code = text.charCodeAt(index);
+      if (code >= 0xd800 && code <= 0xdbff) {
+        code = 0x10000 + ((code - 0xd800) << 10) + text.charCodeAt(++index) - 0xdc00;
+      }
+      if (code < 0x80) { bytes.push(code); }
+      else if (code < 0x800) { bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f)); }
+      else if (code < 0x10000) { bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f)); }
+      else { bytes.push(0xf0 | (code >> 18), 0x80 | ((code >> 12) & 0x3f), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f)); }
+    }
+    return new Uint8Array(bytes);
+  }
+
+  static text(bytes: Uint8Array): string {
+    assertBytes(bytes);
+    const characters: string[] = [];
+    for (let index = 0; index < bytes.length;) {
+      const first = bytes[index++];
+      let code: number;
+      let continuation: number;
+      let minimum: number;
+      if (first < 0x80) { code = first; continuation = 0; minimum = 0; }
+      else if (first >= 0xc2 && first <= 0xdf) { code = first & 0x1f; continuation = 1; minimum = 0x80; }
+      else if (first >= 0xe0 && first <= 0xef) { code = first & 0x0f; continuation = 2; minimum = 0x800; }
+      else if (first >= 0xf0 && first <= 0xf4) { code = first & 7; continuation = 3; minimum = 0x10000; }
+      else { return invalid('Invalid UTF-8 lead byte'); }
+      if (index + continuation > bytes.length) { invalid('Truncated UTF-8'); }
+      for (let count = 0; count < continuation; count += 1) {
+        const next = bytes[index++];
+        if ((next & 0xc0) !== 0x80) { invalid('Invalid UTF-8 continuation'); }
+        code = (code << 6) | (next & 0x3f);
+      }
+      if (code < minimum || code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff)) { invalid('Invalid UTF-8 scalar'); }
+      if (characters.length === 0 && code === 0xfeff) { invalid('UTF-8 BOM'); }
+      if (code <= 0xffff) { characters.push(String.fromCharCode(code)); }
+      else {
+        code -= 0x10000;
+        characters.push(String.fromCharCode(0xd800 | (code >> 10), 0xdc00 | (code & 0x3ff)));
+      }
+    }
+    return characters.join('');
+  }
+
+  static base64UrlEncode(bytes: Uint8Array): string {
+    assertBytes(bytes);
+    let result = '';
+    for (let index = 0; index < bytes.length; index += 3) {
+      const first = bytes[index];
+      const second = index + 1 < bytes.length ? bytes[index + 1] : 0;
+      const third = index + 2 < bytes.length ? bytes[index + 2] : 0;
+      result += BASE64_URL_ALPHABET.charAt(first >> 2);
+      result += BASE64_URL_ALPHABET.charAt(((first & 3) << 4) | (second >> 4));
+      if (index + 1 < bytes.length) { result += BASE64_URL_ALPHABET.charAt(((second & 15) << 2) | (third >> 6)); }
+      if (index + 2 < bytes.length) { result += BASE64_URL_ALPHABET.charAt(third & 63); }
+    }
+    return result;
+  }
+
+  static base64UrlDecode(text: string, expectedLength?: number): Uint8Array {
+    if (typeof text !== 'string' || !/^[A-Za-z0-9_-]*$/.test(text) || text.length % 4 === 1) { invalid('Invalid base64url'); }
+    if (expectedLength !== undefined && (!Number.isSafeInteger(expectedLength) || expectedLength < 0)) { invalid('Invalid expected byte length'); }
+    if (expectedLength !== undefined && Math.floor(text.length * 3 / 4) !== expectedLength) { invalid('Unexpected decoded byte length'); }
+    const bytes: number[] = [];
+    let value = 0;
+    let bits = 0;
+    for (let index = 0; index < text.length; index += 1) {
+      value = (value << 6) | BASE64_URL_ALPHABET.indexOf(text.charAt(index));
+      bits += 6;
+      if (bits >= 8) {
+        bits -= 8;
+        bytes.push((value >> bits) & 255);
+        value &= (1 << bits) - 1;
+      }
+    }
+    const result = new Uint8Array(bytes);
+    if (value !== 0 || SharedCanonicalBytes.base64UrlEncode(result) !== text) { invalid('Non-canonical base64url'); }
+    if (expectedLength !== undefined && result.length !== expectedLength) { invalid('Unexpected decoded byte length'); }
+    return result;
+  }
+
+  static equalBytes(first: Uint8Array, second: Uint8Array): boolean {
+    assertBytes(first); assertBytes(second);
+    if (first.length !== second.length) { return false; }
+    let difference = 0;
+    for (let index = 0; index < first.length; index += 1) { difference |= first[index] ^ second[index]; }
+    return difference === 0;
+  }
+
+  static domain(domainString: string, value: unknown): Uint8Array {
+    const prefix = SharedCanonicalBytes.utf8(domainString);
+    const encoded = SharedCanonicalBytes.encode(value);
+    const result = new Uint8Array(prefix.length + encoded.length);
+    result.set(prefix, 0); result.set(encoded, prefix.length);
+    return result;
+  }
+}

diff --git a/src/director/SharedCommitCodec.ts b/src/director/SharedCommitCodec.ts
new file mode 100644
--- /dev/null
+++ b/src/director/SharedCommitCodec.ts
@@ -0,0 +1,593 @@
+import type { SharedSchemaKind, SharedSchemaMap } from './SharedCommitContracts';
+import { SharedCanonicalBytes, SharedSchemaError } from './SharedCanonicalBytes';
+
+type SharedData = { [key: string]: unknown };
+type SharedRule = (value: unknown) => void;
+type SharedFields = { [key: string]: SharedRule };
+
+function fail(code: 'SchemaInvalid' | 'ValueInvalid' | 'InvariantInvalid' | 'LimitExceeded', message: string): never {
+  throw new SharedSchemaError(code, message);
+}
+function data(value: unknown): SharedData {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) { fail('SchemaInvalid', 'Expected object'); }
+  return value as SharedData;
+}
+function fields(required: SharedFields): SharedRule {
+  return (value: unknown): void => {
+    const object = data(value);
+    const names = Object.keys(object);
+    const wanted = Object.keys(required);
+    if (names.length !== wanted.length || names.some((name) => !Object.prototype.hasOwnProperty.call(required, name))) {
+      fail('SchemaInvalid', 'Unexpected or missing field');
+    }
+    for (const name of wanted) { required[name](object[name]); }
+  };
+}
+function literal(expected: unknown): SharedRule {
+  return (value: unknown): void => { if (value !== expected) { fail('ValueInvalid', 'Unexpected literal'); } };
+}
+function oneOf(values: readonly unknown[]): SharedRule {
+  return (value: unknown): void => { if (values.indexOf(value) < 0) { fail('ValueInvalid', 'Unexpected enum value'); } };
+}
+function stringPattern(pattern: RegExp): SharedRule {
+  return (value: unknown): void => { if (typeof value !== 'string' || !pattern.test(value)) { fail('ValueInvalid', 'Invalid string value'); } };
+}
+function integer(minimum: number, maximum: number = Number.MAX_SAFE_INTEGER): SharedRule {
+  return (value: unknown): void => {
+    if (typeof value !== 'number' || !Number.isSafeInteger(value) || Object.is(value, -0) || value < minimum || value > maximum) {
+      fail('ValueInvalid', 'Integer outside allowed range');
+    }
+  };
+}
+function nullable(rule: SharedRule): SharedRule {
+  return (value: unknown): void => { if (value !== null) { rule(value); } };
+}
+function array(rule: SharedRule): SharedRule {
+  return (value: unknown): void => {
+    if (!Array.isArray(value)) { fail('SchemaInvalid', 'Expected array'); }
+    for (const item of value) { rule(item); }
+  };
+}
+function alternative(rules: readonly SharedRule[]): SharedRule {
+  return (value: unknown): void => {
+    for (const rule of rules) {
+      try { rule(value); return; } catch (error) { if (!(error instanceof SharedSchemaError)) { throw error; } }
+    }
+    fail('SchemaInvalid', 'No exact union alternative');
+  };
+}
+function reference(kind: SharedSchemaKind): SharedRule {
+  return (value: unknown): void => { inspect(kind, value); };
+}
+function binary(length?: number, minimum: number = 0, maximum: number = Number.MAX_SAFE_INTEGER): SharedRule {
+  return (value: unknown): void => {
+    if (typeof value !== 'string') { fail('ValueInvalid', 'Expected base64url string'); }
+    if (value.length > Math.ceil(maximum * 4 / 3)) { fail('LimitExceeded', 'Encoded byte length outside limit'); }
+    const bytes = SharedCanonicalBytes.base64UrlDecode(value, length);
+    if (bytes.length < minimum || bytes.length > maximum) { fail('LimitExceeded', 'Decoded byte length outside limit'); }
+  };
+}
+function decimal(maximum: string): SharedRule {
+  return (value: unknown): void => {
+    if (typeof value !== 'string' || !/^(0|[1-9][0-9]*)$/.test(value) || value.length > maximum.length
+      || (value.length === maximum.length && value > maximum)) { fail('ValueInvalid', 'Invalid unsigned decimal'); }
+  };
+}
+function requireInvariant(condition: boolean, message: string): void {
+  if (!condition) { fail('InvariantInvalid', message); }
+}
+function same(first: unknown, second: unknown): boolean {
+  return SharedCanonicalBytes.equalBytes(SharedCanonicalBytes.encode(first), SharedCanonicalBytes.encode(second));
+}
+function sorted(values: readonly unknown[], key: (value: unknown) => string): void {
+  let previous: string | null = null;
+  for (const value of values) {
+    const next = key(value);
+    requireInvariant(previous === null || previous < next, 'Unsorted or duplicate identity');
+    previous = next;
+  }
+}
+function identityKey(value: unknown): string {
+  const identity = data(value);
+  return String(identity.authorAccountId) + ':' + String(identity.authorSequence);
+}
+function order(first: SharedData, second: SharedData): number {
+  const time = (data(first.appendedAt).epochMs as number) - (data(second.appendedAt).epochMs as number);
+  if (time !== 0) { return time; }
+  const a = data(first.identity); const b = data(second.identity);
+  if (a.authorAccountId !== b.authorAccountId) { return (a.authorAccountId as string) < (b.authorAccountId as string) ? -1 : 1; }
+  return (a.authorSequence as number) - (b.authorSequence as number);
+}
+
+const version = literal(1);
+const profile = literal('ExternalSharedOnlineV1');
+const uuid = stringPattern(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);
+const instance = stringPattern(/^[A-Za-z0-9_.-]{3,128}$/);
+const digest = stringPattern(/^[0-9a-f]{64}$/);
+const fingerprint = binary(32);
+const nonnegative = integer(0);
+const positive = integer(1);
+const bool = oneOf([true, false]);
+const signature = binary(64);
+const nonce = binary(32);
+const uint128 = decimal('340282366920938463463374607431768211455');
+const uint64 = decimal('18446744073709551615');
+const key = fields({ kty: literal('EC'), crv: literal('P-256'), x: binary(32), y: binary(32) });
+const recordFields: SharedFields = {
+  definition: reference('SharedMapEntityDefinition'), createdBy: nullable(reference('WorldCommitIdentity')),
+  lastEditedBy: nullable(reference('WorldCommitIdentity')), deletedBy: nullable(reference('WorldCommitIdentity')),
+};
+const triggerRecordFields: SharedFields = { ...recordFields, definition: reference('SharedTriggerDefinition') };
+const membershipFields: SharedFields = {
+  schemaVersion: version, serviceInstanceId: instance, worldId: uuid, membershipEpoch: positive,
+  previousMembershipEpoch: nullable(positive), key: reference('WorldRelayKeyDescriptor'),
+  credentials: array(reference('WorldMemberCredential')), developerTrustAnchorSha256: digest,
+  developerSignatureBase64Url: signature,
+};
+
+const schemaRules: { [kind: string]: SharedRule } = {
+  WorldCommitIdentity: fields({ authorAccountId: uuid, authorSequence: positive }),
+  SharedPosition: fields({ lateralMilli: integer(-1000000000, 1000000000), depthMilli: integer(-1000000000, 1000000000) }),
+  SharedContentReference: fields({ contentId: stringPattern(/^[A-Za-z0-9_.:/-]{1,128}$/), contentSha256: digest }),
+  SharedAppendedAt: fields({ epochMs: nonnegative }),
+  WorldSharedGenesis: fields({
+    schemaVersion: version, profile, worldId: uuid, mapId: uuid, contentRevision: positive,
+    contentManifestSha256: digest, worldDeveloperAccountId: uuid,
+    developerTrustAnchor: reference('WorldDeveloperTrustAnchor'), initialState: reference('SharedWorldState'),
+  }),
+  AuthorSequenceSegment: fields({
+    schemaVersion: version, serviceInstanceId: instance, segmentId: uuid, authorAccountId: uuid,
+    authorDeviceId: uuid, authorDeviceGeneration: positive, worldId: uuid, membershipEpoch: positive,
+    firstSequence: positive, lastSequence: positive, issuedAtServerEpochMs: nonnegative, expiresAtServerEpochMs: nonnegative,
+  }),
+  WorldAppendPermit: fields({
+    schemaVersion: version, serviceInstanceId: instance, permitId: uuid, requestNonce: nonce, worldId: uuid,
+    identity: reference('WorldCommitIdentity'), authorDeviceId: uuid, authorDeviceGeneration: positive,
+    segmentId: uuid, membershipEpoch: positive, keyEpoch: positive, changeClass: reference('WorldChangeClass'),
+    appendedAt: reference('SharedAppendedAt'), expiresAtServerEpochMs: nonnegative, clockGeneration: positive,
+    clockStatus: literal('Trusted'),
+  }),
+  WorldCommitAdmission: fields({
+    schemaVersion: version, serviceInstanceId: instance, worldId: uuid, identity: reference('WorldCommitIdentity'),
+    envelopeSha256: digest, appendedAt: reference('SharedAppendedAt'), admittedAtServerEpochMs: nonnegative,
+    admissionRevision: positive, membershipEpoch: positive, rosterTargetObserverActiveAtAppendedAt: nullable(bool),
+  }),
+  WorldCommitAdmissionClaim: fields({ schemaVersion: version, serviceInstanceId: instance, requestNonce: nonce,
+    header: reference('RelayCommitHeader'), envelopeSha256: digest }),
+  SignedWorldCommitAdmissionClaim: fields({ claim: reference('WorldCommitAdmissionClaim'), authorSignatureBase64Url: signature }),
